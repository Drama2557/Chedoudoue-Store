# ============================================================
#  .gitignore — Chedoudoue Store
#  Static HTML/CSS/JavaScript project
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
bower_components/

# ── Environment & secrets ────────────────────────────────────
.env
.env.local
.env.*.local

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build & distribution ─────────────────────────────────────
dist/
build/
out/
.cache/
tmp/
temp/

# ── OS generated files ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor & IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# ── Package manager lock files (keep only one) ───────────────
# Uncomment the one you are NOT using to ignore it:
# package-lock.json
# yarn.lock

# ── Miscellaneous ────────────────────────────────────────────
*.bak
*.orig
*.patch

# Local sync exclusions
*.terabox.uploading.cfg
.claude/settings.local.json
